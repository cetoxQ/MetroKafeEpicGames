<UserControl x:Class="MetroKafeEpicGames.Views.PathReplaceEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="620">
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                   Text="Oyun klasörlerini topluca başka yere taşıdıysanız kayıtlardaki yolun başını burada değiştirin. Örnek: X:\Oyunlar\Epic Games → X:\Oyunlar\Epic Games\Epic Games"/>

        <TextBlock Text="Eski yol başı" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="OldBox" TextChanged="Box_TextChanged"/>

        <TextBlock Text="Yeni yol başı" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click" ToolTip="Klasör seç">
                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}"/>
            </Button>
            <TextBox x:Name="NewBox" TextChanged="Box_TextChanged"/>
        </DockPanel>

        <Border Background="#0F4F8CFF" BorderBrush="#2A4F8CFF" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock x:Name="CountText" FontWeight="SemiBold"/>
                <TextBlock x:Name="ExampleText" Style="{StaticResource Hint}" Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>

<UserControl x:Class="MetroKafeEpicGames.Views.InstallsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Baslik -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Reload_Click" ToolTip="Dosyayı diskten yeniden oku (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Yenile"/>
                    </StackPanel>
                </Button>
                <Button Click="Open_Click" Margin="10,0,0,0" ToolTip="Başka bir installations.jsonl aç">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Dosya aç"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="Save_Click" IsEnabled="False"
                        ToolTip="Yedek alıp kaydet (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}"/>
                        <TextBlock x:Name="SaveText" Text="Kaydet"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Kurulumlar" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="FileText" Style="{StaticResource PageSubtitle}" TextTrimming="CharacterEllipsis"
                           Cursor="Hand" MouseLeftButtonUp="FileText_Click" ToolTip="Dosyanın klasörünü aç"/>
            </StackPanel>
        </DockPanel>

        <!-- Ozet -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,20,-6,0">
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Kayıtlı oyun" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatTotal" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Kurulu" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatInstalled" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Silinmiş" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatDeleted" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Klasör / exe sorunu" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                    <TextBlock x:Name="StatProblem" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filtre ve araclar -->
        <DockPanel Grid.Row="2" Margin="0,20,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Click="FindMissing_Click" ToolTip="Klasörü bulunamayan oyunları yakın klasörlerde ara (örn. iç içe kalmış Epic Games\Epic Games)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Kayıp klasörleri bul"/>
                    </StackPanel>
                </Button>
                <Button Click="ReplacePath_Click" Margin="10,0,0,0" ToolTip="Bütün kayıtlarda yolun başını değiştir">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}"/>
                        <TextBlock Text="Yol değiştir"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="SearchBox" Width="220" Margin="10,0,0,0" Tag="Ara: oyun, klasör…" TextChanged="Search_TextChanged" VerticalAlignment="Center"/>
            </StackPanel>
            <ListBox x:Name="FilterChips" Style="{StaticResource ChipList}" SelectionChanged="Filter_SelectionChanged" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Liste -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="13,8,23,8" TextElement.Foreground="{StaticResource FaintTextBrush}" TextElement.FontSize="11.5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DURUM"/>
                    <TextBlock Grid.Column="1" Text="OYUN"/>
                    <TextBlock Grid.Column="2" Text="KLASÖR (dir)"/>
                    <TextBlock Grid.Column="3" Text="SON KAYIT"/>
                </Grid>

                <ListBox x:Name="List" Grid.Row="1" SelectionMode="Extended" ItemContainerStyle="{StaticResource RowItem}"
                         SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Detail}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Installed">
                                                    <Setter Property="Background" Value="#262BD46A"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Incomplete">
                                                    <Setter Property="Background" Value="#2638BDF8"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource InfoBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Deleted">
                                                    <Setter Property="Background" Value="#26F5A524"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="FolderMissing">
                                                    <Setter Property="Background" Value="#26F05252"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="ExeMissing">
                                                    <Setter Property="Background" Value="#26F05252"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="12" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Version}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                        <Setter Property="Text" Value="{Binding SubName}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Dir}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource FaintTextBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastWritten}" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource FaintTextBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding LineCount, Mode=OneWay}"/><Run Text=" satır"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{StaticResource FaintTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource SubTextBrush}" Margin="0,12,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460"/>
                    <Button x:Name="EmptyOpenButton" Margin="0,16,0,0" HorizontalAlignment="Center" Click="Open_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="installations.jsonl seç"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border x:Name="BusyPanel" Grid.RowSpan="3" Background="#CC171B21" CornerRadius="10" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Spinner}" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BusyText" Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Alt islem cubugu -->
                <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="4,6,4,0" Padding="6,12,6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Click="OpenFolder_Click" ToolTip="Oyun klasörünü Gezgin'de aç">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Klasörü aç"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Json_Click" Margin="4,0,0,0" ToolTip="Son satırın JSON'unu düzenle">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE943;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="JSON"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Edit_Click" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Düzenle"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Click="Remove_Click" Margin="12,0,0,0"
                                    ToolTip="Kurulumun bütün satırlarını dosyadan siler; oyun dosyalarına dokunmaz">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}"/>
                                    <TextBlock Text="Kaydı sil"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Click="Restore_Click" Margin="10,0,0,0"
                                    ToolTip="Silinmiş kurulumun silme satırlarını kaldırır">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" Style="{StaticResource Icon}"/>
                                    <TextBlock x:Name="RestoreText" Text="Silinenleri geri yükle"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
